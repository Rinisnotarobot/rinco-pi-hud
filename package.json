{
  "name": "rinco-pi-hud",
  "version": "1.3.0",
  "description": "A dynamic HUD footer for Pi, ported from Sakura Zentui Footer.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rinisnotarobot/rinco-pi-hud.git"
  },
  "homepage": "https://github.com/Rinisnotarobot/rinco-pi-hud#readme",
  "bugs": {
    "url": "https://github.com/Rinisnotarobot/rinco-pi-hud/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "tui",
    "hud",
    "sakura"
  ],
  "files": [
    "extensions",
    "docs",
    "assets/readme/*.svg",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint extensions tests",
    "lint:fix": "eslint extensions tests --fix",
    "format:check": "prettier --check \"extensions/**/*.ts\" \"tests/**/*.ts\" \"eslint.config.js\" \"prettier.config.js\"",
    "format": "prettier --write \"extensions/**/*.ts\" \"tests/**/*.ts\" \"eslint.config.js\" \"prettier.config.js\"",
    "verify": "npm run format:check && npm run typecheck && npm run lint && npm run test",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/hud/index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.83.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.4",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.9"
  }
}
