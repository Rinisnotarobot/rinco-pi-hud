{
  "name": "rinco-pi-hud",
  "version": "1.0.0",
  "description": "A dynamic HUD footer for Pi, ported from Sakura Zentui Footer.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rinisnotarobot/rinco-pi-hud.git"
  },
  "homepage": "https://github.com/Rinisnotarobot/rinco-pi-hud#readme",
  "bugs": {
    "url": "https://github.com/Rinisnotarobot/rinco-pi-hud/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "tui",
    "hud",
    "sakura"
  ],
  "files": [
    "extensions",
    "docs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format:check": "biome format .",
    "format": "biome format --write .",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "pi": {
    "extensions": [
      "./extensions/hud/index.ts"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@earendil-works/pi-ai": "^0.83.0",
    "@types/node": "^24.12.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
